# The frontend output is architecture independent, so build it on the runner.
FROM --platform=$BUILDPLATFORM node:26-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS frontend
WORKDIR /src/web
RUN npm install --global pnpm@12.16.1
COPY web/ ./
RUN --mount=type=cache,id=authelia-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts --store-dir /pnpm/store && \
    pnpm build

# Build on the target platform because SQLite requires CGO.
FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . ./
COPY --from=frontend /src/internal/server/public_html/ ./internal/server/public_html/
COPY api/ ./internal/server/public_html/api/
RUN test -s internal/server/public_html/index.html && \
    test -s internal/server/public_html/api/index.html && \
    test -s internal/server/public_html/api/openapi.yml
ARG BUILD_COMMIT=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 CGO_CPPFLAGS="-D_FORTIFY_SOURCE=2 -fstack-protector-strong" \
    CGO_LDFLAGS="-Wl,-z,relro,-z,now" \
    go build -trimpath -buildmode=pie \
    -ldflags "-linkmode=external -s -w -X github.com/authelia/authelia/v4/internal/utils.BuildCommit=${BUILD_COMMIT} -X github.com/authelia/authelia/v4/internal/utils.BuildState=clean -X github.com/authelia/authelia/v4/internal/utils.BuildBranch=github-actions" \
    -o /out/authelia ./cmd/authelia && \
    /out/authelia --version

FROM authelia/base:latest@sha256:42dcc0af3dd9a926c7002e705aa06e5b44f60f6ed36af2d97f06c85e6c7ef02c
WORKDIR /app
ENV PATH="/app:${PATH}" PUID=0 PGID=0 X_AUTHELIA_CONFIG="/config/configuration.yml"
COPY --from=backend /out/authelia /app/authelia
COPY LICENSE entrypoint.sh healthcheck.sh ./
COPY --chmod=666 .healthcheck.env ./
EXPOSE 9091
ENTRYPOINT ["/app/entrypoint.sh"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=1m CMD /app/healthcheck.sh
